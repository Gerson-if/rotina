# Agendador contínuo do Sistema de Rotina (ALTERNATIVA ao cron).
# Faz a Redistribuição de pendências, métricas e backup rodarem SEM ninguém logado.
#
# Instalar (ajuste User e o caminho se for diferente de /var/www/rotina):
#   sudo cp deploy/rotina-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rotina-worker
# Ver o que está fazendo:  journalctl -u rotina-worker -f
#
# Use cron OU worker, não precisa dos dois (usar os dois não duplica nada: há trava no banco, mas é desnecessário).
[Unit]
Description=Sistema de Rotina - agendador (redistribuição, métricas, backup)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/rotina
ExecStart=/usr/bin/php /var/www/rotina/bin/rotina.php worker --every=20
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
